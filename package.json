{
  "name": "ai-security-reading-hub",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-pages.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "test": "npm run build:pages && node --experimental-strip-types --test tests/*.test.mjs checks/*.test.mjs",
    "test:data": "node --experimental-strip-types --test tests/data-integrity.test.mjs",
    "test:pages": "node --experimental-strip-types --test checks/pages-export.test.mjs",
    "check:links": "node --experimental-strip-types scripts/check-links.mjs",
    "audit": "node scripts/audit-gate.mjs",
    "lint": "eslint .",
    "typecheck": "NEXT_TELEMETRY_DISABLED=1 next typegen && tsc --noEmit",
    "build:report": "node --experimental-strip-types scripts/build-report.mjs"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.5.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "type": "module",
  "displayName": "科技・資安・架構週讀",
  "overrides": {
    "sharp": "0.35.4"
  }
}
